#!/usr/bin/env python3
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from fmvcore.hook import Check, Gates, run  # noqa: E402

UV = ("uv", "run")
GATES = Gates(
    always=(
        Check("format", (*UV, "ruff", "format", "--check", ".")),
        Check("lint", (*UV, "ruff", "check", ".")),
        Check("types", (*UV, "mypy", "fmvcore")),
        Check("tests", (*UV, "python", "-m", "pytest", "--cov=fmvcore", "--cov-fail-under=95")),
    ),
    always_required={"FMVCORE_FFMPEG_REQUIRED": "1", "FMVCORE_CC_REQUIRED": "1"},
)

if __name__ == "__main__":
    sys.exit(run(ROOT, GATES))
